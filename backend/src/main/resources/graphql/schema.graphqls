type Query {
    nodeById(id: ID): Node
    edgeById(id: ID): Edge
    projectById(id: ID): Project
    userById(id: ID): User
    allNodes: [Node]
    allEdges: [Edge]
    allProjects: [Project]
    allUsers: [User]
}

enum NodeType {
    DATABASE
    GATEWAY
    QUEUE
    SERVICE
}

type Node {
    id: ID!
    name: String
    type: NodeType
    xPos: Float
    yPos: Float
}

type Edge {
    id: ID!
    sourceNode: Node
    targetNode: Node
}

type Project {
    id: ID!
    name: String
    description: String
    nodes: [Node]
    edges: [Edge]
}

enum UserRole {
    ADMIN
    USER
}

type User {
    id: ID!
    username: String
    email: String
    role: UserRole
}

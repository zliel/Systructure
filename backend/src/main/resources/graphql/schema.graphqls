type Query {
    nodeById(id: ID): Node
    edgeById(id: ID): Edge
    allNodes: [Node]
    allEdges: [Edge]
}

enum NodeType {
    SERVICE
    DATABASE
    GATEWAY
}

type Node {
    id: ID!
    name: String
    type: NodeType
    xPos: Float
    yPos: Float
}

type Edge {
    id: ID!
    sourceNode: Node
    targetNode: Node
}
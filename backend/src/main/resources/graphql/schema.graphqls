scalar DateTime

type Query {
    nodeById(id: ID): Node
    edgeById(id: ID): Edge
    projectById(id: ID): Project
    myProjects: [Project]
    projectMemberById(id: ID): ProjectMember
    projectMembershipsByUserId(userId: ID!): [ProjectMember]
    projectMembershipsByProjectId(projectId: ID!): [ProjectMember]
    projectMembershipsByUserIdAndProjectRole(userId: ID!, projectRole: ProjectRole!): [ProjectMember]
    userRoleInProject(userId: ID!, projectId: ID!): ProjectRole
    userById(id: ID): User
}

type Mutation {
    createNode(newNodeData: NodeInput!): Node
    updateNode(id: ID!, updatedNodeData: UpdateNodeInput): Node
    deleteNode(id: ID!): Node
    deleteNodes(ids: [ID!]!): [Node]
    createEdge(newEdgeData: EdgeInput!): Edge
    updateEdge(id: ID!, updatedEdgeData: UpdateEdgeInput): Edge
    deleteEdge(id: ID!): Edge
    deleteEdges(ids: [ID!]!): [Edge]
    createProject(newProjectData: CreateProjectInput!): Project
    updateProject(id: ID!, updatedProjectData: ProjectInput): Project
    addProjectMember(input: AddMemberInput!): ProjectMember
    updateProjectMemberRole(input: UpdateMemberRoleInput!): ProjectMember
    removeProjectMember(memberId: ID!): ProjectMember
    updateProfile(input: UpdateProfileInput!): User
}

input UpdateProfileInput {
    username: String
    currentPassword: String
    newPassword: String
}

input NodeInput {
    name: String!
    type: NodeType!
    xPos: Float
    yPos: Float
    projectId: ID!
}

input UpdateNodeInput {
    name: String
    type: NodeType
    xPos: Float
    yPos: Float
    projectId: ID
}

input EdgeInput {
    sourceNodeId: ID!
    targetNodeId: ID!
    projectId: ID!
}

input UpdateEdgeInput {
    sourceNodeId: ID
    targetNodeId: ID
    projectId: ID
}

input ProjectInput {
    name: String
    description: String
    createdById: ID
    isPublic: Boolean
    nodeIds: [ID]
    edgeIds: [ID]
    memberIds: [ID]
}

input CreateProjectInput {
    name: String!
    description: String
    isPublic: Boolean
}

input AddMemberInput {
    projectId: ID!
    identifier: String!
    role: ProjectRole!
}

input UpdateMemberRoleInput {
    memberId: ID!
    role: ProjectRole!
}

enum NodeType {
    DATABASE
    GATEWAY
    QUEUE
    SERVICE
}

type Node {
    id: ID!
    name: String!
    type: NodeType!
    xPos: Float
    yPos: Float
    project: Project!
}

type Edge {
    id: ID!
    sourceNode: Node!
    targetNode: Node!
    project: Project!
}

type Project {
    id: ID!
    name: String!
    description: String
    nodes: [Node]
    edges: [Edge]
    members: [ProjectMember]
    createdBy: User
    createdAt: DateTime
    updatedAt: DateTime
    isPublic: Boolean
}

enum UserRole {
    ADMIN
    USER
}

type User {
    id: ID!
    username: String
    email: String
    role: UserRole
    projectMemberships: [ProjectMember]
}

type ProjectMember {
    id: ID!
    user: User
    project: Project
    projectRole: ProjectRole
    joinedAt: DateTime
}

enum ProjectRole {
    OWNER
    EDITOR
    VIEWER
}
